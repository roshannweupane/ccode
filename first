#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILE_NAME "expenses.dat"

typedef struct {
    char category[50];
    char description[100];
    float amount;
    char date[20];
} Expense;

Expense *expenses = NULL;
int expenseCount = 0;

void loadExpenses();
void saveExpenses();
void addExpense();
void listExpenses();
void searchByCategory();
void totalSpent();

int main() {
    int choice;

    loadExpenses();

    while (1) {
        printf("\n==================== Expense Tracker ====================\n");
        printf("1. Add New Expense\n");
        printf("2. List All Expenses\n");
        printf("3. Search by Category\n");
        printf("4. Show Total Spent\n");
        printf("5. Save & Exit\n");
        printf("==========================================================\n");
        printf("Choose an option: ");
        scanf("%d", &choice);
        getchar();

        switch (choice) {
            case 1:
                addExpense();
                break;
            case 2:
                listExpenses();
                break;
            case 3:
                searchByCategory();
                break;
            case 4:
                totalSpent();
                break;
            case 5:
                saveExpenses();
                printf("Data saved. Goodbye!\n");
                exit(0);
            default:
                printf("Invalid choice. Try again.\n");
        }
    }

    return 0;
}

void loadExpenses() {
    FILE *fp = fopen(FILE_NAME, "rb");
    if (!fp) return;

    fread(&expenseCount, sizeof(int), 1, fp);
    expenses = malloc(sizeof(Expense) * expenseCount);
    fread(expenses, sizeof(Expense), expenseCount, fp);

    fclose(fp);
}

void saveExpenses() {
    FILE *fp = fopen(FILE_NAME, "wb");
    if (!fp) return;

    fwrite(&expenseCount, sizeof(int), 1, fp);
    fwrite(expenses, sizeof(Expense), expenseCount, fp);

    fclose(fp);
}

void addExpense() {
    Expense newExp;

    printf("Enter category: ");
    fgets(newExp.category, 50, stdin);
    newExp.category[strcspn(newExp.category, "\n")] = 0;

    printf("Enter description: ");
    fgets(newExp.description, 100, stdin);
    newExp.description[strcspn(newExp.description, "\n")] = 0;

    printf("Enter amount: ");
    scanf("%f", &newExp.amount);
    getchar();

    printf("Enter date (YYYY-MM-DD): ");
    fgets(newExp.date, 20, stdin);
    newExp.date[strcspn(newExp.date, "\n")] = 0;

    expenseCount++;
    expenses = realloc(expenses, sizeof(Expense) * expenseCount);
    expenses[expenseCount - 1] = newExp;

    printf("Expense added successfully!\n");
}

void listExpenses() {
    if (expenseCount == 0) {
        printf("No expenses recorded.\n");
        return;
    }

    printf("\n==================== All Expenses ====================\n");
    for (int i = 0; i < expenseCount; i++) {
        printf("Expense #%d\n", i + 1);
        printf("Category   : %s\n", expenses[i].category);
        printf("Description: %s\n", expenses[i].description);
        printf("Amount     : $%.2f\n", expenses[i].amount);
        printf("Date       : %s\n", expenses[i].date);
        printf("--------------------------------------------\n");
    }
}

void searchByCategory() {
    char search[50];
    printf("Enter category to search: ");
    fgets(search, 50, stdin);
    search[strcspn(search, "\n")] = 0;

    int found = 0;

    printf("\n=========== Expenses in Category: %s ===========\n", search);

    for (int i = 0; i < expenseCount; i++) {
        if (strcasecmp(expenses[i].category, search) == 0) {
            printf("Description: %s\n", expenses[i].description);
            printf("Amount     : $%.2f\n", expenses[i].amount);
            printf("Date       : %s\n", expenses[i].date);
            printf("----------------------------------------\n");
            found = 1;
        }
    }

    if (!found) {
        printf("No expenses found in this category.\n");
    }
}

void totalSpent() {
    float total = 0;

    for (int i = 0; i < expenseCount; i++) {
        total += expenses[i].amount;
    }

    printf("Total money spent: $%.2f\n", total);
}
